    <string name="allow_insecure_http">允许不安全的 HTTP 连接</string>
    <string name="insecure_http_help">开启后允许 HTTP，仍受访问地址白名单和配对授权限制。HTTP 不加密，屏幕内容、操作和凭据可能被窃听。建议保持关闭。</string>
    <string name="access_allowlist">访问地址白名单</string>
    <string name="access_allowlist_entries">允许的 IP 地址和域名</string>
    <string name="access_allowlist_hint">每行一个 IP 地址或域名，不含协议、端口、路径或通配符。</string>
    <string name="access_allowlist_invalid">请检查每一行：填写一个有效的 IP 地址或域名，不含协议、端口、路径或通配符。</string>
    <string name="access_allowlist_help">留空仅允许通过手机自身 IP 访问；填写后仅允许列表中的访问地址。加入白名单不会开启 HTTP，默认仍需 HTTPS，仅本机 127.0.0.1 例外。使用本机控制台时也需将 127.0.0.1 列入。</string>
    <string name="access_allowlist_active">当前仅允许白名单中的地址，网络连通和端口映射仍需另行配置。</string>
    <string name="local_console_blocked">白名单未允许本机 Web 控制台。请在设置中加入 127.0.0.1，或清空列表恢复默认 IP 访问。</string>
    <string name="save_allowlist">保存白名单</string>
    <string name="keep_alive_title">后台保活</string>
    <string name="keep_alive_status_enabled">后台保活：已开启</string>
    <string name="keep_alive_status_disabled">后台保活：已关闭</string>
    <string name="keep_alive_settings">保活设置</string>
    <string name="keep_alive_dashboard_enabled_help">请在保活设置中继续允许系统后台运行和自启动，并取消省电限制。否则即使网络正常，也可能出现连接卡住、操作变慢或超时。</string>
    <string name="keep_alive_dashboard_disabled_help">使用前请开启后台保活，并按设置指引解除系统后台限制，以免连接卡住、操作变慢或超时。从最近任务中移除应用会停止控制服务。</string>
    <string name="keep_alive_connection_help">请开启后台保活，并在系统中允许后台运行、自启动，取消省电限制。后台受限时，即使网络正常，安全连接也可能长时间等待，导致操作变慢或超时。仅开启此开关不会自动解除系统限制。</string>
    <string name="keep_alive_enabled_help">通过常驻通知维持控制服务，系统回收、开机、应用更新或无障碍重新连接后尝试恢复。可能增加耗电。</string>
    <string name="keep_alive_disabled_help">已关闭自动恢复。从最近任务中移除 Phone Use 时停止控制服务；切换到其他应用仍可继续当前会话。不会撤销无障碍授权或修改系统省电设置。</string>
    <string name="keep_alive_battery_exempt">系统电池优化：已豁免</string>
    <string name="keep_alive_battery_restricted">系统电池优化：仍有限制，可能导致连接卡住、操作变慢或超时</string>
    <string name="keep_alive_battery_settings">电池优化设置</string>
    <string name="keep_alive_autostart_settings">自启动设置</string>
    <string name="keep_alive_xiaomi_help">HyperOS / MIUI：允许 Phone Use 自启动，将省电策略设为「无限制」，并在最近任务中锁定。自启动状态需手动确认；快捷入口不可用时会打开应用详情。</string>
    <string name="keep_alive_huawei_help">在「应用启动管理」中对 Phone Use 选择手动管理，允许自启动、关联启动和后台活动，并锁定最近任务。请手动确认；快捷入口不可用时会打开应用详情。</string>
    <string name="keep_alive_autostart_help">允许 Phone Use 自启动和后台运行，取消省电限制，并在最近任务中锁定。请手动确认这些设置；快捷入口不可用时会打开应用详情。</string>
    <string name="keep_alive_samsung_help">在「电池 → 后台使用限制」中，将 Phone Use 加入「从不休眠的应用」。按钮会打开应用详情，请同时允许后台电池使用。需手动确认这些设置。</string>
    <string name="keep_alive_generic_help">在系统应用设置中允许后台电池使用；若有自启动选项，请允许。系统支持时可锁定最近任务。选项因设备而异，需手动确认。</string>
    <string name="keep_alive_notifications_help">控制服务通知已关闭。允许通知可随时查看后台状态，并快速返回 Phone Use。</string>
    <string name="keep_alive_notification_settings">通知设置</string>
    <string name="keep_alive_limits">系统权限需要你确认授权。强行停止及部分厂商限制仍可终止应用；强行停止后请重新打开 Phone Use。无障碍若已关闭，需在系统设置中重新开启。</string>
    <string name="keep_alive_settings_unavailable">无法打开设置。请在系统设置中进入 Phone Use 的应用详情，允许后台运行和自启动。</string>
</resources>
